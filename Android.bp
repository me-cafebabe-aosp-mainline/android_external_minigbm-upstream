// found in the LICENSE file.

package {
    default_applicable_licenses: ["external_minigbm_license_upstream"],
}

// Added automatically by a large-scale-change that took the approach of
// 'apply every license found to every target'. While this makes sure we respect
// every license restriction, it may not be entirely correct.
//
// e.g. GPL in an MIT project might only apply to the contrib/ directory.
//
// Please consider splitting the single license below into multiple licenses,
// taking care not to lose any license_kind information, and overriding the
// default license using the 'licenses: [...]' property on targets as needed.
//
// For unused files, consider creating a 'fileGroup' with "//visibility:private"
// to attach the license to, and including a comment whether the files may be
// used in the current project.
// See: http://go/android-license-faq
license {
    name: "external_minigbm_license_upstream",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
        "SPDX-license-identifier-BSD",
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
    ],
}

filegroup {
    name: "minigbm_core_files_upstream",

    srcs: [
        "amdgpu.c",
        "backend_mock.c",
        "dma_heap.c",
        "dri_gbm.c",
        "drv.c",
        "drv_array_helpers.c",
        "drv_helpers.c",
        "dumb_driver.c",
        "i915.c",
        "mediatek.c",
        "msm.c",
        "rockchip.c",
        "staging.c",
        "vc4.c",
        "virtgpu.c",
        "virtgpu_cross_domain.c",
        "virtgpu_virgl.c",
        "vmwgfx.c",
        "xe.c",
    ] + select(soong_config_variable("minigbm_upstream", "enable_gbm_mesa_driver"), {
        true: [
            "gbm_mesa_driver/gbm_mesa_driver.cpp",
            "gbm_mesa_driver/gbm_mesa_internals.cpp",
        ],
        default: [],
    }),
}

filegroup {
    name: "minigbm_gralloc_common_files_upstream",

    srcs: [
        "cros_gralloc/cros_gralloc_buffer.cc",
        "cros_gralloc/cros_gralloc_driver.cc",
        "cros_gralloc/cros_gralloc_helpers.cc",
    ],
}

filegroup {
    name: "minigbm_gralloc0_files_upstream",
    srcs: ["cros_gralloc/gralloc0/gralloc0.cc"],
}

// amdgpu.c with dri_gbm.c: Mesa's libgbm (libgbm_mesa.so) allocates tiled buffers, linear-only
// when it is absent. The backend only binds to "amdgpu" DRM devices, so other GPUs are unaffected.
amdgpu_cflags = ["-DDRV_AMDGPU"]

gbm_mesa_cflags = [
    "-DDRV_GBM_MESA",
    "-DHAS_DMABUF_SYSTEM_HEAP",
]
generic_cflags = ["-DHAS_DMABUF_SYSTEM_HEAP"]
intel_cflags = [
    "-DDRV_I915",
    "-DDRV_XE",
]
meson_cflags = ["-DDRV_MESON"]
msm_cflags = [
    "-DDRV_MSM",
    "-DHAS_DMABUF_SYSTEM_HEAP",
    "-DQCOM_DISABLE_COMPRESSED_NV12",
]

mediatek_cflags = [
    "-DDRV_MEDIATEK",
    "-DHAS_DMABUF_SYSTEM_HEAP",
]

vc4_cflags = ["-DDRV_VC4"]

vmwgfx_cflags = ["-DDRV_VMWGFX"]

// gbm_mesa is excluded, as it requires more configuration
all_cflags = amdgpu_cflags + generic_cflags + intel_cflags + meson_cflags + msm_cflags + mediatek_cflags + vc4_cflags + vmwgfx_cflags
all_arm_cflags = generic_cflags + meson_cflags + msm_cflags + mediatek_cflags + vc4_cflags + vmwgfx_cflags
all_x86_cflags = amdgpu_cflags + generic_cflags + intel_cflags + vmwgfx_cflags

cc_defaults {
    name: "minigbm_defaults_upstream",

    cflags: [
        "-D_FILE_OFFSET_BITS=64",
        "-D_GNU_SOURCE=1",
        "-Wall",
        "-Wcast-align",
        "-Wcast-qual",
        "-Wno-unused-parameter",
        "-Wpointer-arith",
        "-Wsign-compare",
    ] + select(soong_config_variable("minigbm_upstream", "platform"), {
        "all": all_cflags,
        "all_arm": all_arm_cflags,
        "all_x86": all_x86_cflags,
        "amdgpu": amdgpu_cflags,
        "generic": generic_cflags,
        "intel": intel_cflags,
        "meson": meson_cflags,
        "msm": msm_cflags,
        "mt8186": mediatek_cflags + ["-DMTK_MT8186"],
        "mt8188": mediatek_cflags + ["-DMTK_MT8188G"],
        "mt8196": mediatek_cflags + ["-DMTK_MT8196"],
        "vc4": vc4_cflags,
        "vmwgfx": vmwgfx_cflags,
        default: [],
    }) + select(soong_config_variable("minigbm_upstream", "cflags"), {
        any @ flag_val: flag_val,
        default: [],
    }) + select(soong_config_variable("minigbm_upstream", "enable_gbm_mesa_driver"), {
        true: gbm_mesa_cflags,
        default: [],
    }),

    // amdgpu.h (AMDGPU_TIMEOUT_INFINITE); libdrm_amdgpu itself is not linked.
    include_dirs: ["external/libdrm-upstream/amdgpu"],

    product_variables: {
        platform_sdk_version: {
            cflags: ["-DANDROID_API_LEVEL=%d"],
        },
    },

    required: select(soong_config_variable("minigbm_upstream", "enable_gbm_mesa_driver"), {
        true: ["libgbm_mesa_wrapper"],
        default: [],
    }),
}

cc_library_headers {
    name: "minigbm_headers_upstream",
    host_supported: true,
    vendor_available: true,
    export_include_dirs: ["."],
}

cc_defaults {
    name: "minigbm_cros_gralloc_defaults_upstream",

    defaults: ["minigbm_defaults_upstream"],

    header_libs: [
        "libhardware_headers",
        "libnativebase_headers",
        "libsystem_headers",
        "minigbm_headers_upstream",
    ],

    static_libs: ["libarect"],

    vendor: true,

    shared_libs: [
        "libcutils",
        "libdmabufheap",
        "libdrm",
        "libgralloctypes",
        "liblog",
        "libnativewindow",
        "libsync",
    ],
}

cc_defaults {
    name: "minigbm_cros_gralloc_library_defaults_upstream",

    defaults: ["minigbm_cros_gralloc_defaults_upstream"],
    srcs: [
        ":minigbm_core_files_upstream",
        ":minigbm_gralloc_common_files_upstream",
    ],
}

cc_defaults {
    name: "minigbm_cros_gralloc0_defaults_upstream",

    defaults: ["minigbm_cros_gralloc_defaults_upstream"],
    relative_install_path: "hw",

    srcs: [":minigbm_gralloc0_files_upstream"],
}

cc_library {
    name: "libgbm_upstream",
    defaults: ["minigbm_defaults_upstream"],
    host_supported: true,
    min_sdk_version: "apex_inherit",

    srcs: [
        ":minigbm_core_files_upstream",
        "gbm.c",
        "gbm_helpers.c",
        "minigbm_helpers.c",
    ],

    target: {
        host: {
            // Avoid linking to another host copy of libdrm; this library will cause
            // binary GPU drivers to be loaded from the host, which might be linked
            // to a system copy of libdrm, which conflicts with the AOSP one
            allow_undefined_symbols: true,
            header_libs: ["libdrm_headers"],
        },
        android: {
            shared_libs: [
                "libcutils",
                "liblog",
            ],
            static_libs: [
                "libdrm",
            ],
        },
    },
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    vendor_available: true,
    product_available: true,

    export_include_dirs: ["."],
}

// Rust bindings to minigbm, generated in a way compatible with gbm crate.
rust_bindgen {
    name: "libgbm_sys_upstream",
    crate_name: "gbm_sys_upstream",
    wrapper_src: "rust/gbm_wrapper.h",
    source_stem: "bindings",
    bindgen_flags: [
        "--allowlist-function=^gbm_.*$",
        "--allowlist-type=^gbm_.*$",
        "--allowlist-var=GBM_.*|gbm_.*$",
        "--blocklist-type=__BINDGEN_TMP_.*",
        "--constified-enum-module=^gbm_.*$",
    ],
    shared_libs: ["libgbm_upstream"],
    host_supported: true,
    vendor_available: true,
    product_available: true,
    min_sdk_version: "34",
    apex_available: [
        "//apex_available:anyapex",
        "//apex_available:platform",
    ],
    visibility: [
        "//external/rust/android-crates-io/crates/gbm",
        "//system/desktop/cros-codecs",
    ],
}

// Generic
cc_library_shared {
    name: "libminigbm_gralloc_upstream",
    defaults: ["minigbm_cros_gralloc_library_defaults_upstream"],
    cflags: generic_cflags,
}

cc_library_shared {
    name: "gralloc.minigbm_upstream",
    defaults: ["minigbm_cros_gralloc0_defaults_upstream"],
    shared_libs: ["libminigbm_gralloc_upstream"],
}

cc_library_headers {
    name: "libminigbm_gralloc_headers_upstream",
    host_supported: true,
    vendor_available: true,
    export_include_dirs: ["cros_gralloc"],
    visibility: [
        "//device/generic/goldfish/hals/hwc3:__subpackages__",
    ],
}
