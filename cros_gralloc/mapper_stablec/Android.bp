package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "wildroid_external_minigbm_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    default_applicable_licenses: ["wildroid_external_minigbm_license"],
}

cc_defaults {
    name: "defaults_mapper.minigbm_wildroid",
    defaults: ["wildroid_minigbm_gralloc4_common_defaults"],
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
    ],
    header_libs: [
        "libbase_headers",
        "libimapper_stablec",
        "libimapper_providerutils",
    ],
    srcs: [
        ":wildroid_minigbm_gralloc4_mapper_files",
        "Mapper.cpp",
    ],
    cpp_std: "c++20",
}

cc_library_shared {
    name: "mapper.minigbm_wildroid",
    defaults: ["defaults_mapper.minigbm_wildroid"],
    shared_libs: [
        "libminigbm_wildroid_gralloc",
    ],
    vintf_fragments: select(soong_config_variable("minigbm", "include_vintf_fragments"), {
        false: [],
        default: ["mapper.minigbm_wildroid.xml"],
    }),
}

cc_library_shared {
    name: "mapper.minigbm_wildroid_generic_x86",
    defaults: ["defaults_mapper.minigbm_wildroid"],
    shared_libs: [
        "libminigbm_wildroid_gralloc_generic_x86",
    ],
    vintf_fragments: select(soong_config_variable("minigbm", "include_vintf_fragments"), {
        false: [],
        default: ["mapper.minigbm_wildroid_generic_x86.xml"],
    }),
}

prebuilt_etc {
    name: "mapper.minigbm_wildroid.xml",
    src: "mapper.minigbm_wildroid.xml",
    sub_dir: "vintf",
    installable: false,
}

prebuilt_etc {
    name: "mapper.minigbm_wildroid_generic_x86.xml",
    src: "mapper.minigbm_wildroid_generic_x86.xml",
    sub_dir: "vintf",
    installable: false,
}
