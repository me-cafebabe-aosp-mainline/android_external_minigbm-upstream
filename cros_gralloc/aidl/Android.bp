package {
    // See: http://go/android-license-faq
    // A large-scale-change added 'default_applicable_licenses' to import
    // all of the 'license_kinds' from "wildroid_external_minigbm_license"
    // to get the below license kinds:
    //   SPDX-license-identifier-Apache-2.0
    //   SPDX-license-identifier-BSD
    default_applicable_licenses: ["wildroid_external_minigbm_license"],
}

cc_defaults {
    name: "defaults_android.hardware.graphics.allocator-service.minigbm_wildroid",
    defaults: ["wildroid_minigbm_cros_gralloc_defaults"],
    relative_install_path: "hw",
    vintf_fragments: select(soong_config_variable("minigbm", "include_vintf_fragments"), {
        false: [],
        default: ["allocator.minigbm_wildroid.xml"],
    }),
    vendor: true,
    shared_libs: [
        "android.hardware.graphics.allocator-V2-ndk",
        "android.hardware.graphics.mapper@4.0",
        "libbase",
        "libbinder_ndk",
        "libgralloctypes",
        "libhidlbase",
        "liblog",
        "libminigbm_wildroid_gralloc",
        "libminigbm_wildroid_gralloc4_utils",
    ],
    static_libs: [
        "libaidlcommonsupport",
    ],
    srcs: [
        "Allocator.cpp",
        "Main.cpp",
    ],
}

cc_binary {
    name: "android.hardware.graphics.allocator-service.minigbm_wildroid",
    defaults: ["defaults_android.hardware.graphics.allocator-service.minigbm_wildroid"],
    init_rc: select(soong_config_variable("minigbm", "include_init_rc"), {
        false: [],
        default: ["allocator.minigbm_wildroid.rc"],
    }),
    cflags: [
        "-DIMAPPER_LIBRARY_SUFFIX=\"minigbm_wildroid\"",
    ],
    shared_libs: [
        "libminigbm_wildroid_gralloc",
    ],
}

cc_binary {
    name: "android.hardware.graphics.allocator-service.minigbm_wildroid_generic_x86",
    defaults: ["defaults_android.hardware.graphics.allocator-service.minigbm_wildroid"],
    init_rc: select(soong_config_variable("minigbm", "include_init_rc"), {
        false: [],
        default: ["allocator.minigbm_wildroid_generic_x86.rc"],
    }),
    cflags: [
        "-DIMAPPER_LIBRARY_SUFFIX=\"minigbm_wildroid_generic_x86\"",
    ],
    shared_libs: [
        "libminigbm_wildroid_gralloc_generic_x86",
    ],
}

filegroup {
    name: "allocator.minigbm_wildroid.rc",
    srcs: ["allocator.minigbm_wildroid.rc"]
}

filegroup {
    name: "allocator.minigbm_wildroid_generic_x86.rc",
    srcs: ["allocator.minigbm_wildroid_generic_x86.rc"]
}

prebuilt_etc {
    name: "allocator.minigbm_wildroid.xml",
    src: "allocator.minigbm_wildroid.xml",
    sub_dir: "vintf",
    installable: false,
}
